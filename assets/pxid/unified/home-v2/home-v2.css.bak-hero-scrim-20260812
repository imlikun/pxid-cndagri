  }

  #home .v2-process-nav::-webkit-scrollbar {
    display: none;
  }

  #home .v2-process-tab {
    min-height: 62px;
    font-size: 12px;
  }

  #home .v2-evidence-steps {
    gap: 48px;
    padding-bottom: 82px;
  }

  #home .v2-evidence-mobile-image {
    margin-bottom: 20px;
  }

  #home .v2-evidence-step-number {
    margin-bottom: 15px;
  }

  #home .v2-evidence-step h3 {
    margin-bottom: 16px;
  }

  #home .v2-industries,
  #home .v2-industry-layout {
    min-height: 780px;
  }

  #home .v2-industry-layout {
    padding: 86px 0;
  }

  #home .v2-industry-tab {
    grid-template-columns: 50px 1fr auto;
    min-height: 96px;
  }

  #home .v2-faq {
    min-height: auto;
    padding: 86px 0;
  }

  #home .v2-final-inner {
    min-height: 600px;
    padding: 82px 0;
  }

  #home .v2-final h2 {
    font-size: clamp(54px, 18vw, 82px);
  }

  #home .v2-final-side {
    padding: 30px 0;
    border: 0;
    border-top: 1px solid rgba(29,35,34,.18);
    border-radius: 0;
    box-shadow: none;
    background: transparent;
  }
}

@media (prefers-reduced-motion: reduce) {
  html.v2-motion-ready #home .v2-motion-head h2,
  html.v2-motion-ready #home .v2-motion-head p,
  html.v2-motion-ready #home .v2-motion-case,
  html.v2-motion-ready #home .v2-motion-evidence .v2-evidence-sticky,
  html.v2-motion-ready #home .v2-motion-evidence .v2-evidence-step,
  html.v2-motion-ready #home .v2-motion-process .v2-process-visual,
  html.v2-motion-ready #home .v2-motion-process .v2-process-panel,
  html.v2-motion-ready #home .v2-motion-process .v2-process-nav,
  html.v2-motion-ready #home .v2-motion-industries .v2-industry-copy,
  html.v2-motion-ready #home .v2-motion-industries .v2-industry-nav,
  html.v2-motion-ready #home .v2-motion-faq h2,
  html.v2-motion-ready #home .v2-motion-faq details,
  html.v2-motion-ready #home .v2-motion-final h2,
  html.v2-motion-ready #home .v2-motion-final .v2-final-side {
    opacity: 1 !important;
    transform: none !important;
    clip-path: none !important;
  }

  #home .v2-section *,
  #home .v2-section *::before,
  #home .v2-section *::after {
    scroll-behavior: auto !important;
    animation: none !important;
    transition-duration: 0.001ms !important;
  }
}
