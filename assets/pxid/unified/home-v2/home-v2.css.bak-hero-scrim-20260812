}

html.v2-motion-ready #home .v2-motion-process .v2-process-panel {
  transform: translate3d(52px, 0, 0);
  transition-delay: 90ms;
}

html.v2-motion-ready #home .v2-motion-process .v2-process-nav {
  transform: translate3d(0, 24px, 0);
  transition-delay: 190ms;
}

