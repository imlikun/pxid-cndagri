@media (hover: hover) and (pointer: fine) {
  #home .v2-final .v2-action:hover {
    background: #343b39;
  }
}

@media (max-width: 1100px) {
  .wb-site-header .wb-main-nav {
    display: none !important;
  }

  .wb-site-header .wb-menu-toggle {
    display: flex !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .wb-site-header .wb-header-cta {
    display: none !important;
  }

  #home .v2-section-inner {
    width: calc(100% - 56px);
  }

  #home .v2-section .v2-section-head {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  #home .v2-case-stage,
  #home .v2-process-stage {
    grid-template-columns: 1fr;
  }

  #home .v2-case-visual,
  #home .v2-process-visual {
    min-height: 56vw;
  }

  #home .v2-case-panel {
    min-height: 540px;
  }

  #home .v2-evidence-layout {
    grid-template-columns: 1fr;
  }

  #home .v2-evidence-sticky {
    display: none;
  }

  #home .v2-evidence-steps {
    display: grid;
    gap: 64px;
    padding-bottom: 110px;
  }

  #home .v2-evidence-step {
    min-height: 0;
    padding: 0;
    opacity: 1;
  }

  #home .v2-evidence-mobile-image {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    display: block;
    margin-bottom: 28px;
    border-radius: var(--v2-media-radius);
    object-fit: cover;
  }

  #home .v2-industry-layout {
    grid-template-columns: 1fr;
    gap: 55px;
    padding: 120px 0;
  }

  #home .v2-final-inner {
    grid-template-columns: 1fr;
    min-height: 650px;
    padding: 100px 0;
  }

  #home .v2-final-side {
    max-width: 520px;
  }
}

@media screen and (orientation: portrait) {
  :root {
    --v2-section-title: 5vw;
    --v2-feature-title: clamp(28px, 8vw, 38px);
    --v2-body-size: 14px;
  }

  #home .v2-section-head h2,
  #home .v2-industry-copy h2,
  #home .v2-faq h2 {
    margin-left: 0;
  }
}

@media (max-width: 680px) {
  #home .banner .group .tab {
    min-width: 0;
    padding: 10px 14px;
  }

  #home .banner .group .tab span {
    font-size: 14px !important;
    line-height: 1.2 !important;
  }

  #home .v2-section-inner {
    width: calc(100% - 40px);
  }

  #home .v2-section .v2-section-head {
    padding: 82px 0 38px;
  }

  #home .v2-cases {
    padding-bottom: 82px;
  }

  #home .v2-case-stage {
    min-height: 0;
  }

  #home .v2-case-visual {
    min-height: 68vw;
  }

  #home .v2-case-panel {
    min-height: 500px;
    padding: 36px 24px;
  }

  #home .v2-case-name {
    font-size: 56px;
  }

  #home .v2-case-tab {
    grid-template-columns: 36px 1fr auto;
    min-height: 68px;
    padding: 0 12px;
    border-radius: 8px;
  }

  #home .v2-process {
