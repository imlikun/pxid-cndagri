html.v2-motion-ready #home .v2-motion-faq details:nth-child(3) { transition-delay: 140ms; }

html.v2-motion-ready #home .v2-motion-final h2 {
  transform: translate3d(-46px, 0, 0);
}

html.v2-motion-ready #home .v2-motion-final .v2-final-side {
  transform: translate3d(0, 38px, 0) scale(.98);
  transition-delay: 120ms;
}

